pkgname=bankstown
pkgver=1.1.0
pkgrel=3
pkgdesc='Bankstown LV2 bass enhancement plugin'
arch=('x86_64')
url='https://github.com/chadmed/bankstown'
license=('MIT')
depends=('glibc' 'gcc-libs')
makedepends=('git' 'cargo' 'make')
source=('bankstown::git+https://github.com/chadmed/bankstown.git#commit=e9829c9bccf5ed73768135c0ddd506f5a6690f9e')
sha256sums=('SKIP')
build() {
  cd "$srcdir/bankstown"
  cargo build --release --locked
}
package() {
  cd "$srcdir/bankstown"
  make DESTDIR="$pkgdir" LIBDIR=/usr/lib install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
