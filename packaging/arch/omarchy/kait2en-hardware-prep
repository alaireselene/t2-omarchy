#!/usr/bin/env python3
import time, subprocess
from pathlib import Path

GPU = Path("/sys/bus/pci/devices/0000:03:00.0")
HDA = Path("/sys/bus/pci/devices/0000:03:00.1")

subprocess.run(["udevadm", "settle", "--timeout=20"])

# HDMI audio rebind
if HDA.exists() and not list(HDA.glob("sound/card*")):
    driver = Path("/sys/bus/pci/drivers/snd_hda_intel")
    if (driver / "0000:03:00.1").exists():
        (driver / "unbind").write_text("0000:03:00.1")
    (driver / "bind").write_text("0000:03:00.1")
    deadline = time.monotonic() + 10
    while not list(HDA.glob("sound/card*")):
        if time.monotonic() > deadline: break
        time.sleep(0.5)

if (HDA / "power/control").exists():
    (HDA / "power/control").write_text("auto")

if (GPU / "power/control").exists():
    (GPU / "power/control").write_text("auto")
if (GPU / "power_dpm_force_performance_level").exists():
    (GPU / "power_dpm_force_performance_level").write_text("auto")

# Ensure T2 NCM link is up with link-local address for Touch ID
ncm = Path("/sys/class/net/enp4s0f1u1")
if ncm.exists():
    subprocess.run(["ip", "link", "set", "dev", "enp4s0f1u1", "addrgenmode", "eui64"])
    subprocess.run(["ip", "link", "set", "dev", "enp4s0f1u1", "up"])
