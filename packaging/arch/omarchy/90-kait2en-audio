#!/bin/bash
set -euo pipefail

# Only run on MacBookPro16,1
[[ -r /sys/class/dmi/id/product_name ]] || exit 0
[[ "$(cat /sys/class/dmi/id/product_name)" == "MacBookPro16,1" ]] || exit 0

config="/etc/pipewire/pipewire.conf.d/51-t2-dsp.conf"
reference="/usr/share/t2-dsp/pipewire/16_1.conf"

if [[ ! -f "$config" || ! -f "$reference" ]]; then
    echo "KaiT2en audio check failed: configuration missing" >&2
    notify-send -u critical "KaiT2en audio" "Configuration missing" 2>/dev/null || true
    exit 1
fi

nodes=$(pw-dump 2>/dev/null || true)

# Self-healing: if PipeWire started before ALSA node was ready, restart user audio once
if [[ "$nodes" != *"audio_effect.t2-161-speakers"* ]]; then
    systemctl --user restart pipewire.service 2>/dev/null || true
    sleep 2
    nodes=$(pw-dump 2>/dev/null || true)
fi

# Verify both DSP nodes are active
if [[ "$nodes" != *"audio_effect.t2-161-speakers"* || "$nodes" != *"audio_effect.t2-161-mic"* ]]; then
    echo "KaiT2en audio check failed: DSP nodes unavailable in PipeWire" >&2
    notify-send -u critical "KaiT2en audio" "DSP nodes unavailable in PipeWire" 2>/dev/null || true
    exit 1
fi
# Ensure competing Omarchy speaker tuning is off
omarchy audio tuning off >/dev/null 2>&1 || true

# Set default mic to DSP if raw mic was selected
current_source=$(wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)
if echo "$current_source" | grep -q 'alsa_input.t2-16_1.RawMic'; then
    mic_id=$(pw-dump 2>/dev/null | jq -r '.[] | select(.info.props["node.name"] == "audio_effect.t2-161-mic") | .id' 2>/dev/null || true)
    if [[ -n "$mic_id" ]]; then
        wpctl set-default "$mic_id" 2>/dev/null || true
    fi
fi

echo "KaiT2en audio: model configuration and both DSP nodes present; competing Omarchy tuning disabled."
