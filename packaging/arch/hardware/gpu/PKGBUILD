pkgname=kait2en-hybrid-gpu
pkgver=7.2.11
pkgrel=1
pkgdesc='KAIT2EN GMUX runtime PM and MacBookPro16,1 GPU fixes for linux-t2 7.2.11.arch1-1'
arch=('x86_64')
url='https://github.com/kaiT2en/KaiT2en-Fedora'
license=('GPL-2.0-only' 'MIT')
depends=('linux-t2=7.2.11.arch1-1' 'kait2en-gmux-dkms')
makedepends=('linux-t2-headers=7.2.11.arch1-1' 'libelf' 'pahole')
options=('!debug')
_kver=7.2.11-arch1-Watanare-T2-1-t2
source=("https://cdn.kernel.org/pub/linux/kernel/v7.x/linux-$pkgver.tar.xz" 'gpu-runtime-7.2.11.patch')
sha256sums=('fd0fc479f983a8c05313f13e9c36330fe6651cf725396748c40d5cd93fa1e6a4' '3412b4da9e2e44b72b57d1d003d0112eb55166391de42631a4bcf09cce739552')

prepare() {
  cd "$srcdir/linux-$pkgver"
  patch --batch --forward -p1 -i "$srcdir/gpu-runtime-7.2.11.patch"
}

build() {
  local tree="$srcdir/linux-$pkgver" headers="/usr/lib/modules/$_kver/build"
  make -j6 -C "$headers" M="$tree/drivers/gpu/drm/amd/amdgpu" modules
  make -j3 -C "$headers" M="$tree/sound/hda/controllers" snd-hda-intel.ko
}

package() {
  local tree="$srcdir/linux-$pkgver" dest="$pkgdir/usr/lib/modules/$_kver/updates/kait2en-hybrid"
  install -Dm644 "$tree/drivers/gpu/drm/amd/amdgpu/amdgpu.ko" "$dest/amdgpu.ko"
  install -Dm644 "$tree/sound/hda/controllers/snd-hda-intel.ko" "$dest/snd-hda-intel.ko"
  install -Dm644 "$srcdir/gpu-runtime-7.2.11.patch" "$pkgdir/usr/share/doc/$pkgname/gpu-runtime-7.2.11.patch"
}
