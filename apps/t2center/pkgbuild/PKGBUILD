pkgname=t2center
pkgver=0.1.0
pkgrel=2
pkgdesc='Apple T2 hardware power, fan curves, battery protection and transcoding control center'
arch=('x86_64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'ffmpeg' 'python' 'polkit')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/t2center "$pkgdir/usr/bin/t2center"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/t2center.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/t2center.svg"
  install -Dm644 "$startdir/t2center.desktop" "$pkgdir/usr/share/applications/t2center.desktop"
  install -Dm755 "$startdir/../../../packaging/arch/omarchy/t2-control" "$pkgdir/usr/libexec/t2-control"
  install -Dm644 "$startdir/../../../packaging/arch/omarchy/org.omarchy.t2control.policy" "$pkgdir/usr/share/polkit-1/actions/org.omarchy.t2control.policy"
}
